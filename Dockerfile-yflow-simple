# YFlow YflowDockerfile - Simple Version
FROM node:20.19-bullseye-slim

# Install system dependencies
RUN apt-get update && \
    apt-get install -y \
    curl \
    nginx \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Bun using npm
RUN npm install -g bun@1.3.1

# Install PM2
RUN npm install -g pm2@6.0.10

# Set working directory
WORKDIR /usr/src/app

# Copy package files
COPY package.json bun.lock ./
COPY packages ./packages

# Install dependencies
RUN bun install

# Build packages
RUN bun run build:react-ui && \
    bun run build:server-api

# Copy configuration files
COPY .env.example ./.env
COPY nginx.react.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Copy frontend build
RUN cp -r packages/react-ui/dist /usr/share/nginx/html

# Create cache directory
RUN mkdir -p /usr/src/app/cache

# Expose ports
EXPOSE 80 443 3000

# Start script
ENTRYPOINT ["/docker-entrypoint.sh"]
