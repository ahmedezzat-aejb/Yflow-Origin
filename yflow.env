## YFlow Environment Configuration

# Frontend URL
AP_FRONTEND_URL=https://app.yflow.ru

# Environment
AP_ENVIRONMENT=prod

# Database Configuration
AP_POSTGRES_DATABASE=yflow
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=your_password_here

# Security
AP_API_KEY=your_api_key_here
AP_ENCRYPTION_KEY=your_256_bit_encryption_key_here_in_hex
AP_JWT_SECRET=your_jwt_secret_here

# Webhook Configuration
AP_WEBHOOK_TIMEOUT_SECONDS=30

# Engine Configuration
AP_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js

# Trigger Configuration
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5

# YooKassa Payment System
AP_YOOKASSA_API_KEY=your_yookassa_api_key
AP_YOOKASSA_SHOP_ID=your_yookassa_shop_id
AP_YOOKASSA_WEBHOOK_SECRET=your_yookassa_webhook_secret

# App Configuration
AP_APP_TITLE=YFlow
AP_FAVICON_URL=https://yflow.ru/favicon.ico
